{
	"name": "trading-simulator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"i18n:compile": "node scripts/compile-i18n.mjs",
		"i18n:watch": "node --watch-path=messages --watch-path=project.inlang scripts/compile-i18n.mjs",
		"dev": "pnpm i18n:compile && vite dev",
		"build": "pnpm i18n:compile && vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "pnpm i18n:compile && (svelte-kit sync || echo '')",
		"check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "pnpm i18n:compile && vitest run",
		"test": "pnpm i18n:compile && vitest run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.0",
		"@vitest/browser-playwright": "^5.0.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.1",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"decimal.js": "^10.6.0",
		"formsnap": "^2.0.1",
		"mode-watcher": "^1.1.0",
		"openid-client": "^6.8.8",
		"sveltekit-superforms": "3.0.0-next.1",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
