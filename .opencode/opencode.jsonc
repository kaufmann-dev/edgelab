{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"svelte": {
			"type": "remote",
			"url": "https://mcp.svelte.dev/mcp",
			"enabled": true
		},
		"playwright": {
			"type": "local",
			"command": ["pnpm", "dlx", "@playwright/mcp@latest", "--browser", "chromium"],
			"enabled": false
		},
		"postgres": {
			"type": "local",
			"command": ["pnpm", "dlx", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
			"enabled": false
		},
		"resend": {
			"type": "local",
			"command": ["pnpm", "dlx", "resend-mcp"],
			"enabled": false,
			"environment": {
				"RESEND_API_KEY": "{env:RESEND_API_KEY}"
			}
		},
		"glitchtip": {
			"type": "remote",
			"url": "{env:GLITCHTIP_MCP_URL}",
			"enabled": false
		}
	}
}
