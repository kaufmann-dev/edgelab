# PostgreSQL
DATABASE_URL="postgres://user:password@localhost:5432/trading_simulator"

# Canonical application origin (HTTPS except for localhost development)
ORIGIN="http://localhost:5173"

# Confidential OpenID Connect client
OIDC_ISSUER_URL="http://localhost:1411"
OIDC_CLIENT_ID="trading-simulator"
OIDC_CLIENT_SECRET=""
# Generate with: openssl rand -base64 32
OIDC_DATA_ENCRYPTION_KEY=""

# Massive market data. Stocks Starter is the minimum simulation plan.
MASSIVE_API_KEY=""
MASSIVE_STOCKS_PLAN="starter"
# Optional: set this only when the key has an options plan.
# MASSIVE_OPTIONS_PLAN="starter"
